{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "subscription": {
          ".write": false
        },
        "profile": {
          "stripeCustomerId": { ".write": false }
        }
      }
    }
  }
}
