# Copy to functions/.env and fill in real values, or set as Firebase Functions
# config/secrets before deploying. Never commit the real .env file.

# Stripe Price IDs (from Stripe Dashboard → Products). Not secret, but keep
# them out of client code — the callable function resolves plan keys server-side.
STRIPE_PRICE_EXPLORER_MONTHLY=price_xxx
STRIPE_PRICE_EXPLORER_ANNUAL=price_xxx
STRIPE_PRICE_FAMILY_MONTHLY=price_xxx
STRIPE_PRICE_FAMILY_ANNUAL=price_xxx

# Public site URL used for Checkout success/cancel redirects
SITE_URL=https://cignara.github.io/KivoraV3
